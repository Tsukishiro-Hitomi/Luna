Output docs/demo.gif

Require luna

Set Shell "zsh"
Set FontFamily "Menlo"
Set FontSize 20
Set Width 1200
Set Height 720
Set Padding 24
Set Margin 24
Set MarginFill "#181825"
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
Set TypingSpeed 25ms
Set Framerate 24
Set PlaybackSpeed 2.0

Type "luna solve 005_eval_negation_stub --model anthropic/claude-haiku-4.5 --budget 0.10"
Enter
Sleep 45s
