# Luna — gateway credentials. Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env

# Required: your aggregation-gateway key and base URL.
ANTHROPIC_API_KEY=your-gateway-key-here
# NOTE: do NOT end the base URL in /v1 — the SDK appends it, so a trailing /v1 → 404.
ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Optional knobs (uncomment to override defaults).
# LUNA_MODEL=anthropic/claude-opus-4.8      # model id used by the agent
# LUNA_TEST_CMD=pytest -q                   # default test command for `cli.py run`
# PORT=8000                                     # chat server port (serve.py)
